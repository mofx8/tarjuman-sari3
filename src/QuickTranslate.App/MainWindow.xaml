<Window x:Class="QuickTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="ترجمان سريع" Width="980" Height="680" MinWidth="720" MinHeight="480"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: languages + window actions -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SourceBox" Grid.Column="0" />
            <Button x:Name="SwapBtn" Grid.Column="1" Margin="8,0" Padding="12,6" ToolTip="تبديل اللغتين">
                <icons:PackIconLucide Kind="ArrowLeftRight" Width="16" Height="16" />
            </Button>
            <ComboBox x:Name="TargetBox" Grid.Column="2" />
            <Button x:Name="SettingsBtn" Grid.Column="3" Margin="12,0,0,0" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconLucide Kind="Settings" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="الإعدادات" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ToggleButton x:Name="PinBtn" Grid.Column="4" Margin="8,0,0,0" Padding="10,6" ToolTip="تثبيت النافذة فوق كل النوافذ">
                <icons:PackIconLucide Kind="Pin" Width="16" Height="16" />
            </ToggleButton>
            <Button x:Name="LangBtn" Grid.Column="5" Margin="8,0,0,0" Padding="12,6" />
        </Grid>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <!-- Translate -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Languages" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="الترجمة" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" FontSize="16"
                             VerticalScrollBarVisibility="Auto" Padding="10" FlowDirection="LeftToRight" />
                    <TextBox x:Name="OutputBox" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap" FontSize="18" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Padding="10" FlowDirection="RightToLeft" />

                    <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <Button x:Name="TranslateBtn" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Play" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="ترجمة (Ctrl+Enter)" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearBtn" Padding="12,6" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Eraser" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="مسح" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PasteBtn" Padding="12,6" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="ClipboardPaste" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="لصق" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImgClipBtn" Padding="12,6" Margin="0,0,8,6" ToolTip="ترجمة صورة من الحافظة">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="ScanText" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="صورة من الحافظة" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImgFileBtn" Padding="12,6" Margin="0,0,8,6" ToolTip="ترجمة صورة من ملف">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="ImagePlus" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="صورة من ملف" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                        <Button x:Name="CopyBtn" Padding="12,6" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Copy" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="نسخ" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SpeakBtn" Padding="12,6" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Volume2" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="نطق" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveFavBtn" Padding="12,6" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Star" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="مفضلة" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CompareBtn" Padding="12,6" Margin="0,0,8,6" ToolTip="ترجمة النص بكل المحركات ومقارنتها">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Scale" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="مقارنة المحركات" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- History -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="History" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="السجل والمفضلة" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Padding="8" ToolTip="ابحث في السجل" />
                        <CheckBox x:Name="FavOnly" Grid.Column="1" Content="المفضلة فقط" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ListView x:Name="HistoryList" Grid.Row="1" Margin="0,8,0,0" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FlowDirection="LeftToRight" Opacity="0.7" />
                                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Opacity="0.65">
                                            <icons:PackIconLucide Kind="Cpu" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Meta}" FontSize="12" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <icons:PackIconLucide Grid.Column="1" Kind="Star" Width="16" Height="16" Foreground="#F59E0B"
                                                          Visibility="{Binding StarVisibility}" VerticalAlignment="Top" Margin="8,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="HistUseBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Replace" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="إعادة استخدام" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistFavBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Star" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="تبديل المفضلة" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistDelBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Trash2" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="حذف" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistClearBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Eraser" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="مسح السجل" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistExportBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="FileDown" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="تصدير CSV" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- Log -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="ScrollText" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="اللوق" Margin="8,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="LogFilter" Width="190" />
                        <CheckBox x:Name="LogAutoScroll" Content="تمرير تلقائي" IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="LogList" Grid.Row="1" Margin="0,8,0,0" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" /><ColumnDefinition Width="84" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Opacity="0.6" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source}" Opacity="0.75" />
                                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="LogClearBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Trash2" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="مسح اللوق" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogCopyBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Copy" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="نسخ اللوق" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogFolderBtn" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="FolderOpen" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="فتح مجلد الملفات" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" />
    </Grid>
</Window>


